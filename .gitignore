# CodeIgniter environment and runtime data
.env
writable/cache/*
!writable/cache/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html

# PHP dependencies and test artifacts
/vendor/
/build/
/phpunit.result.cache

# Node.js / Tailwind dependencies
/node_modules/

# Editor and operating-system files
/.vscode/
/.idea/
*.code-workspace
.DS_Store
Thumbs.db
